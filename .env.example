# Mẫu biến môi trường — sao chép thành .env (đã bị gitignore) rồi điền giá trị thật.
#   cp .env.example .env

# ----- Mô hình -----
TARGET_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
DRAFT_MODEL=                      # checkpoint EAGLE-2 tương ứng — chốt ở M0 (câu hỏi mở M-02)
HF_TOKEN=                         # nếu cần tải model gated
HF_HOME=./.hf_cache

# ----- Máy phục vụ -----
SERVE_LANE=adaptive               # vanilla | static | adaptive
SERVE_HOST=0.0.0.0
SERVE_PORT=8000
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=4096

# ----- Adaptive Proposer -----
PROFILE_CACHE_PATH=./.cache/hw_profile.json   # bảng chi phí C(N,B) đo lúc khởi động
ALPHA_WINDOW=32                   # cửa sổ trượt tính α
TREE_BUDGETS=0,8,16,32,60         # tập ngân sách rời rạc (giữ CUDA graph ổn định)
VRAM_SAFETY_MARGIN_MB=512

# ----- Quan trắc -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ----- Benchmark -----
BENCH_WARMUP_REQUESTS=3
BENCH_REPEATS=5
BENCH_CONCURRENCY=1,2,4,8,16,32
BENCH_OUTPUT_DIR=./experiments/runs
