+    assert result.cost_decision.selected_cap == 2 and result.batch_k == 2
+    assert result.per_request_base_k["A"] == 4
+    states=p._candidate_decision_states(s,{"A":4},())
+    p.cost_governor.profile=profile_for(p,states,(1.,2.,2.,1.1))
