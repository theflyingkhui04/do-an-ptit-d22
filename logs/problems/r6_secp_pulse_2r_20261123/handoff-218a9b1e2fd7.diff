+    assert {r["cohort_id"] for r in rows["records"]}=={"synthetic-cohort-1"}
+    assert len({r["retirement_window_id"] for r in rows["records"]})==3
+    row=rows["records"][-1]
+    assert row["consumer_cost_ms"]==1. and row["consumer_cost_unit"]=="ms/retired_batch"
