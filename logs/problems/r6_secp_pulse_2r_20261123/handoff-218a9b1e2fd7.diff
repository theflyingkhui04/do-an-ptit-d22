+class CollectorCanonicalityStatus(str, Enum):
+    CANONICAL = "CANONICAL"
+    NONCANONICAL = "NONCANONICAL"
+    UNSUPPORTED = "UNSUPPORTED"
+    INVALID = "INVALID"
